SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_OUTPUTS_BUCKET=outputs
ENHANCEAI_ENVIRONMENT=production
ENHANCEAI_USE_REAL_OMNIVOICE=false
ENHANCEAI_LOG_LEVEL=INFO
ENHANCEAI_OMNIVOICE_QUANTIZE_INT8=true
ENHANCEAI_OMNIVOICE_NUM_STEP=8
ENHANCEAI_OMNIVOICE_GUIDANCE_SCALE=1.6
# Comma-separated browser origins allowed by CORS. Set this to your deployed
# frontend URL(s). "*" allows any origin (credentials are then disabled).
ENHANCEAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# In-memory job store cap; oldest finished jobs are evicted past this.
ENHANCEAI_MAX_JOBS_RETAINED=1000
# Concurrent shorts analysis/render jobs (each drives ffmpeg + Whisper).
ENHANCEAI_MAX_SHORTS_JOBS=2
# Prune generated outputs/uploads older than this many hours on startup (0=off).
ENHANCEAI_OUTPUT_RETENTION_HOURS=0
